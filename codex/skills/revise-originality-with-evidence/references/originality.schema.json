{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zdzZDZ123/zotero-obsidian-codex-word-wps-workflow/schemas/originality.schema.json",
  "title": "Evidence-grounded originality revision contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manuscript", "bibliography", "evidence_manifest"],
  "properties": {
    "schema_version": {"const": 1},
    "manuscript": {"type": "string", "minLength": 1},
    "bibliography": {"type": "string", "minLength": 1},
    "evidence_manifest": {"type": "string", "minLength": 1},
    "ars_integrity_report": {"type": "string"},
    "similarity_reports": {"type": "array", "items": {"type": "string"}},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["zh", "en"]}},
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terms": {"type": "array", "items": {"type": "string"}},
        "sections": {"type": "array", "items": {"type": "string"}}
      }
    },
    "output_root": {"type": "string"},
    "revision_proposals": {"type": "string"},
    "recheck_results": {"type": "string"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_human_approval": {"type": "boolean"},
        "block_severities": {"type": "array", "uniqueItems": true, "items": {"enum": ["CRITICAL", "SERIOUS", "MODERATE", "MINOR"]}}
      }
    },
    "release_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "max_overall_similarity_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "require_vendor_recheck": {"type": "boolean"},
        "max_report_age_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "require_report_after_revision": {"type": "boolean"},
        "accepted_vendors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["cnki", "turnitin", "ithenticate"]}
        },
        "attestation": {"type": "string", "minLength": 1}
      }
    }
  }
}
